sources:
  audit-workstation_a-log:
    type: file
    include:
      - "/opt/app/audit-workstation_a.log"
    read_from: beginning

  workstation_a-nginx-access-log:
    type: file
    include:
      - "/tmp/app/nginx/logs/access.log"
    read_from: beginning

  workstation_a-inconsistent-logs:
    type: file
    include:
      - "/opt/app/logs/*.log"
    read_from: beginning


transforms:
  re-audit-workstation_a-log:
    type: remap
    inputs: ["audit-workstation_a-log"]
    source: |
      .app = "workstation_a-workstation"
      .user = "{{ identify }}"

  re-workstation_a-nginx-access-log:
    type: remap
    inputs: ["workstation_a-nginx-access-log"]
    source: |
      .app = "workstation_a-workstation"
      .user = "{{ identify }}"

  re-workstation_a-inconsistent-logs:
    type: remap
    inputs: ["workstation_a-inconsistent-logs"]
    source: |
      .app = "workstation_a-workstation"
      .user = "{{ identify }}"


sinks:
  victorialogs:
    type: elasticsearch
    inputs:
      - re-audit-workstation_a-log
      - re-workstation_a-nginx-access-log
      - re-workstation_a-inconsistent-logs
    endpoints: ["https://{{ log_storage_ip }}:9428/insert/elasticsearch/"]
    api_version: v8
    compression: gzip
    query:
      _msg_field: "message"
      _time_field: "timestamp"
      _stream_fields: "app,user"
      ignore_fields: "source_type,host"
    healthcheck:
      enabled: false
    buffer:
      type: memory
      max_events: 5000
